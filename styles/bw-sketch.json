    ],
    "butter": [
      "fonts/ZCOOLQingKeHuangYou-Regular.ttf",
      "fonts/ZCOOLQingKeHuangYou-Regular.ttf"
    ],
    "xiaowei": [
      "fonts/ZCOOLXiaoWei-Regular.ttf",
      "fonts/ZCOOLXiaoWei-Regular.ttf"
    ],
    "handwriting": [
